{
  "name": "my-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "vp run --filter ./apps/storybook dev",
    "dev": "vp run --parallel --no-cache --log labeled --filter \"./apps/*\" dev",
    "demo:inter-knot": "vp run --filter ./apps/inter-knot-demo dev",
    "demo:ghostly-grove": "vp run --filter ./apps/ghostly-grove-demo dev",
    "demo:furbobo-gossip": "vp run --filter ./apps/furbobo-gossip-demo dev",
    "demo:prts": "vp run --filter ./apps/prts-demo dev",
    "build": "vp run --filter ./apps/overview build && vp run --filter ./apps/storybook build && vp run --filter \"./apps/*-demo\" build",
    "test": "vp run --filter ./tests test",
    "e2e": "vp run --filter ./tests e2e",
    "check": "vp check && vp run -r typecheck",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "format": "vp fmt",
    "deploy": "void deploy --platform cloudflare"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "void": "1.6.2"
  },
  "packageManager": "pnpm@12.16.1"
}
